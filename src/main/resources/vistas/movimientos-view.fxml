<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.upb.inventarioquimicos.controladores.MovimientoInvController"
            stylesheets="@../estilos/styles.css">

    <top>
        <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="12">
            <Label text="Sistema de Inventario Químico" styleClass="header-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Historial de Movimientos" styleClass="header-page"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="12" style="-fx-padding: 20;">
            <Label text="Historial de Movimientos" styleClass="section-label"/>

            <TableView fx:id="tablaMovimientos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colFecha"    text="Fecha"       prefWidth="95"/>
                    <TableColumn fx:id="colTipo"     text="Tipo"        prefWidth="85"/>
                    <TableColumn fx:id="colProducto" text="Producto"    prefWidth="130"/>
                    <TableColumn fx:id="colOrigen"   text="Origen"      prefWidth="110"/>
                    <TableColumn fx:id="colDestino"  text="Destino"     prefWidth="110"/>
                    <TableColumn fx:id="colUnidad"   text="Unidad"      prefWidth="70"/>
                    <TableColumn fx:id="colUsuario"  text="Realizado por" prefWidth="130"/>
                    <TableColumn fx:id="colObs"      text="Observación" prefWidth="180"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <HBox>
                <Button text="&#8592; Volver" styleClass="btn-secondary" onAction="#volver"/>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <fx:include source="menu-views.fxml"/>
    </bottom>

</BorderPane>
