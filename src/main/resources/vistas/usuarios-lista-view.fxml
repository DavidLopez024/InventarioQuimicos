<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.upb.inventarioquimicos.controladores.UsuariosListaController"
            stylesheets="@../estilos/styles.css">

    <top>
        <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="12">
            <Label text="Sistema de Inventario Químico" styleClass="header-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Lista de Usuarios" styleClass="header-page"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="12" style="-fx-padding: 20;">
            <Label text="Usuarios Registrados" styleClass="section-label"/>

            <TableView fx:id="tablaUsuarios" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNombre"   text="Nombre completo" prefWidth="220"/>
                    <TableColumn fx:id="colUsername" text="Usuario"         prefWidth="160"/>
                    <TableColumn fx:id="colRol"      text="Rol"             prefWidth="140"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <HBox spacing="12">
                <Button text="Eliminar" styleClass="btn-danger"    onAction="#eliminarUsuario"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="&#8592; Volver" styleClass="btn-secondary" onAction="#volver"/>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <fx:include source="menu-views.fxml"/>
    </bottom>

</BorderPane>
