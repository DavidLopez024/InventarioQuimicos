<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.upb.inventarioquimicos.controladores.ProductosListaController"
            stylesheets="@../estilos/styles.css">

    <top>
        <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="12">
            <Label text="Sistema de Inventario Químico" styleClass="header-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Lista de Productos" styleClass="header-page"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="12" style="-fx-padding: 20;">
            <Label text="Productos Registrados" styleClass="section-label"/>

            <TableView fx:id="tablaProductos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNombre" text="Nombre"      prefWidth="260"/>
                    <TableColumn fx:id="colStock"  text="Stock mín."  prefWidth="120"/>
                    <TableColumn fx:id="colUnidad" text="Unidad"      prefWidth="120"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <HBox spacing="12">
                <Button text="Editar"   styleClass="btn-primary"   onAction="#editarProducto"/>
                <Button text="Eliminar" styleClass="btn-danger"    onAction="#eliminarProducto"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="← Volver"    styleClass="btn-secondary" onAction="#volver"/>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <fx:include source="menu-views.fxml"/>
    </bottom>

</BorderPane>
